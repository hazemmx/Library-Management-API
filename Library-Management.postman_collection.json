    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Borrower",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "if (jsonData.token) {\r",
                  "    // 1. Clear it from everywhere else first\r",
                  "    pm.globals.unset(\"token\");\r",
                  "    pm.collectionVariables.unset(\"token\");\r",
                  "\r",
                  "    // 2. Set it in the Environment\r",
                  "    pm.environment.set(\"token\", jsonData.token);\r",
                  "    \r",
                  "    console.log(\"✅ Cleaned old scopes and updated Environment token!\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"email\":\"carol.martinez@example.com\"\r\n}",
